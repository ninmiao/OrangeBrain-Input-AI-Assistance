#include <windows.h>
// The version comes from windows/app/CMakeLists.txt (ZEPHYR_VER_*).
#ifndef ZEPHYR_VER_MAJOR
#error ZEPHYR_VER_MAJOR/MINOR/PATCH required
#endif
#define ZEPHYR_STR2(x) #x
#define ZEPHYR_STR(x) ZEPHYR_STR2(x)
#define ZEPHYR_VER_STR ZEPHYR_STR(ZEPHYR_VER_MAJOR) "." ZEPHYR_STR(ZEPHYR_VER_MINOR) "." ZEPHYR_STR(ZEPHYR_VER_PATCH)
#ifndef ZEPHYR_DESCRIPTION
#define ZEPHYR_DESCRIPTION "Zephyr Input native Windows application"
#endif
101 ICON "zephyr.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION ZEPHYR_VER_MAJOR,ZEPHYR_VER_MINOR,ZEPHYR_VER_PATCH,0
PRODUCTVERSION ZEPHYR_VER_MAJOR,ZEPHYR_VER_MINOR,ZEPHYR_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo" BEGIN
  BLOCK "040904b0" BEGIN
   VALUE "CompanyName", "Zephyr Input"
   VALUE "FileDescription", ZEPHYR_DESCRIPTION
   VALUE "FileVersion", ZEPHYR_VER_STR
   VALUE "LegalCopyright", "Zephyr Input contributors, GPL-3.0-or-later"
   VALUE "ProductName", "Zephyr Input"
   VALUE "ProductVersion", ZEPHYR_VER_STR
  END
 END
 BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END
END
