#include <windows.h>
// The version comes from windows/app/CMakeLists.txt (ORANGECELL_VER_*).
#ifndef ORANGECELL_VER_MAJOR
#error ORANGECELL_VER_MAJOR/MINOR/PATCH required
#endif
#define ORANGECELL_STR2(x) #x
#define ORANGECELL_STR(x) ORANGECELL_STR2(x)
#define ORANGECELL_VER_STR ORANGECELL_STR(ORANGECELL_VER_MAJOR) "." ORANGECELL_STR(ORANGECELL_VER_MINOR) "." ORANGECELL_STR(ORANGECELL_VER_PATCH)
#ifndef ORANGECELL_DESCRIPTION
#define ORANGECELL_DESCRIPTION "OrangeCell native Windows application"
#endif
101 ICON "orangecell.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION ORANGECELL_VER_MAJOR,ORANGECELL_VER_MINOR,ORANGECELL_VER_PATCH,0
PRODUCTVERSION ORANGECELL_VER_MAJOR,ORANGECELL_VER_MINOR,ORANGECELL_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo" BEGIN
  BLOCK "040904b0" BEGIN
   VALUE "CompanyName", "OrangeCell"
   VALUE "FileDescription", ORANGECELL_DESCRIPTION
   VALUE "FileVersion", ORANGECELL_VER_STR
   VALUE "LegalCopyright", "OrangeCell contributors, GPL-3.0-or-later"
   VALUE "ProductName", "OrangeCell"
   VALUE "ProductVersion", ORANGECELL_VER_STR
  END
 END
 BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x409, 1200 END
END
