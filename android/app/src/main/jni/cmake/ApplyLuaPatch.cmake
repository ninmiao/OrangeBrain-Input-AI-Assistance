file(LOCK "${LOCK_FILE}" GUARD PROCESS TIMEOUT 60)
execute_process(COMMAND "${GIT}" apply --check "${PATCH}" WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE can_apply ERROR_QUIET)
if(can_apply EQUAL 0)
  execute_process(COMMAND "${GIT}" apply "${PATCH}" WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE applied)
  if(NOT applied EQUAL 0)
    message(FATAL_ERROR "Cannot apply Lua Android compatibility patch")
  endif()
else()
  execute_process(COMMAND "${GIT}" apply --reverse --check "${PATCH}" WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE already_applied ERROR_QUIET)
  if(NOT already_applied EQUAL 0)
    message(FATAL_ERROR "Lua source does not match either patched or unpatched revision")
  endif()
endif()
